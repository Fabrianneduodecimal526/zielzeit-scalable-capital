#!/bin/bash
#
# Write the README's downloads badge into site/badge/, for the Pages workflow to
# publish and shields.io to render through its `endpoint` badge.
#
#     Scripts/usage-badges [--repo OWNER/NAME]
#
# One figure, from the release API and nothing else. The app itself sends no
# telemetry and must not start: this is counted by GitHub on the way out, and it
# cannot identify anyone.
#
#   downloads  every .dmg asset across every release, summed. Both names count
#              (Zielzeit.dmg and Zielzeit-1.2.dmg are the same build published
#              twice so the "latest" URL can stay stable), but a person takes
#              one or the other, so the sum is a person count and not a double.
#
# shields.io cannot sum this itself: its github/downloads badge either totals
# every asset — which would fold in appcast.xml polls and the zip Sparkle takes,
# roughly doubling the figure — or reports a single asset in a single release,
# which restarts at zero every time a release is cut.
set -euo pipefail

cd "$(dirname "$0")/.."

REPO="Mannafee/zielzeit-scalable-capital"

while [ $# -gt 0 ]; do
    case "$1" in
        --repo) REPO="$2"; shift 2 ;;
        *) echo "usage: Scripts/usage-badges [--repo OWNER/NAME]" >&2; exit 64 ;;
    esac
done

BADGE_DIR="site/badge"
EMERALD="3ECF8E"          # the app's own accent, so the badge reads as its own
mkdir -p "$BADGE_DIR"

downloads=$(gh api "repos/$REPO/releases" --paginate |
    jq '[.[].assets[] | select(.name | endswith(".dmg")) | .download_count] | add // 0')

jq -n --argjson message "$downloads" --arg color "$EMERALD" \
    '{schemaVersion: 1, label: "downloads", message: ($message | tostring), color: $color}' \
    > "$BADGE_DIR/downloads.json"

echo "downloads=$downloads"
