#!/bin/bash
#
# Cut a release: bump the version, land it on main, tag it, and let the Release
# workflow build and publish the downloads.
#
#     Scripts/release              # infer the version from the commits
#     Scripts/release 1.4          # use this version
#     Scripts/release minor        # force the bump kind
#     Scripts/release --dry-run    # print the plan, change nothing
#
# Deliberately one script rather than steps in a document: the release that went
# wrong went wrong at a hand step, and every check here exists because something
# it catches has already happened once.
set -euo pipefail

cd "$(dirname "$0")/.."

DRY_RUN=false
WANTED=""
for arg in "$@"; do
    case "$arg" in
        --dry-run) DRY_RUN=true ;;
        major|minor|patch) WANTED="$arg" ;;
        [0-9]*) WANTED="$arg" ;;
        *) echo "usage: Scripts/release [VERSION|major|minor|patch] [--dry-run]" >&2; exit 64 ;;
    esac
done

say()  { printf '\033[1m==>\033[0m %s\n' "$1"; }
fail() { printf '\033[31merror:\033[0m %s\n' "$1" >&2; exit 1; }

# Sparkle's SPM package ships only the framework: the signing tools are in the
# official tarball, so it is fetched and pinned. A checksum mismatch is fatal —
# this tarball's output signs the update every user installs.
SPARKLE_VERSION=2.9.4
SPARKLE_SHA=ce89daf967db1e1893ed3ebd67575ed82d3902563e3191ca92aaec9164fbdef9
SPARKLE_TOOLS=".build/sparkle-tools/$SPARKLE_VERSION"

sparkle_tools() {
    [ -x "$SPARKLE_TOOLS/bin/generate_appcast" ] && return
    say "Fetching the Sparkle $SPARKLE_VERSION tools"
    mkdir -p "$SPARKLE_TOOLS"
    local tarball
    tarball=$(mktemp -t sparkle)
    curl -fsSL -o "$tarball" \
        "https://github.com/sparkle-project/Sparkle/releases/download/$SPARKLE_VERSION/Sparkle-$SPARKLE_VERSION.tar.xz" \
        || fail "could not download the Sparkle tools"
    local got
    got=$(shasum -a 256 "$tarball" | cut -d' ' -f1)
    [ "$got" = "$SPARKLE_SHA" ] \
        || fail "Sparkle tarball checksum mismatch: got $got, expected $SPARKLE_SHA"
    tar -xJf "$tarball" -C "$SPARKLE_TOOLS" || fail "could not extract the Sparkle tools"
    rm -f "$tarball"
}

# ---------------------------------------------------------------- preflight

command -v gh >/dev/null || fail "gh is not installed"
gh auth status >/dev/null 2>&1 || fail "gh is not logged in — run: gh auth login"
REPO=$(gh repo view --json nameWithOwner -q .nameWithOwner)

[ -n "$(git status --porcelain)" ] && fail "working tree is dirty — commit or stash first"

say "Fetching"
git fetch --quiet --tags origin

BRANCH=$(git rev-parse --abbrev-ref HEAD)
[ "$BRANCH" = "main" ] || fail "on branch '$BRANCH' — releases are cut from main"

# The release must describe what is on the remote, not a local main that is
# behind it or carrying unpushed commits.
git merge-base --is-ancestor HEAD origin/main \
    || fail "local main has commits that are not on origin/main — push them first"
git merge --ff-only origin/main --quiet

LAST_TAG=$(git describe --tags --abbrev=0 --match 'v*' 2>/dev/null || echo "")
[ -n "$LAST_TAG" ] || fail "no v* tag to release against"

# --------------------------------------------------------- infer the version

# Merge commits are skipped: their subject is "Merge pull request #N", which
# says nothing about what the branch contained.
#
# Read in a loop rather than with `mapfile`, which is bash 4 and macOS ships 3.2.
SUBJECTS=()
while IFS= read -r line; do
    SUBJECTS+=("$line")
done < <(git log --no-merges --format='%s' "$LAST_TAG..origin/main")
[ "${#SUBJECTS[@]}" -gt 0 ] && [ -n "${SUBJECTS[0]}" ] \
    || fail "no commits since $LAST_TAG — nothing to release"

# Inference is best-effort and this repo's history is mixed: not every subject
# is conventional, and an unprefixed one cannot be classified. So the reasoning
# is printed per commit and the version can always be passed explicitly.
BUMP="patch"
RELEASE_WORTHY=false
say "Commits since $LAST_TAG"
for subject in "${SUBJECTS[@]}"; do
    kind="patch"
    case "$subject" in
        *"!:"*|*"BREAKING CHANGE"*)      kind="major" ;;
        feat*|i18n*)                     kind="minor" ;;
        fix*|perf*)                      kind="patch" ;;
        docs*|ci*|chore*|test*|refactor*) kind="none"  ;;
        *)                               kind="patch" ;;   # unclassifiable: assume it ships something
    esac
    printf '    %-6s %s\n' "$kind" "$subject"
    [ "$kind" = "none" ] || RELEASE_WORTHY=true
    case "$kind" in
        major) BUMP="major" ;;
        minor) [ "$BUMP" = "major" ] || BUMP="minor" ;;
    esac
done

$RELEASE_WORTHY || fail "only docs/ci/chore commits since $LAST_TAG — nothing users would notice"

CURRENT=$(/usr/libexec/PlistBuddy -c "Print :CFBundleShortVersionString" Info.plist)
IFS=. read -r MA MI PA <<<"$CURRENT"
PA=${PA:-0}

if [[ "$WANTED" =~ ^[0-9] ]]; then
    NEW="$WANTED"
    # Not the inferred kind: printing "1.1 -> 2.0 (patch)" invites the reader to
    # trust an inference that was overridden.
    BUMP="given"
else
    [ -n "$WANTED" ] && BUMP="$WANTED"
    case "$BUMP" in
        major) NEW="$((MA + 1)).0" ;;
        minor) NEW="$MA.$((MI + 1))" ;;
        # Two components while the patch is 0, matching v1.0 and v1.1, so a
        # feature release stays "1.2" rather than becoming "1.2.0".
        patch) NEW="$MA.$MI.$((PA + 1))" ;;
    esac
fi

[ "$NEW" = "$CURRENT" ] && fail "version is already $CURRENT"
git rev-parse -q --verify "refs/tags/v$NEW" >/dev/null && fail "tag v$NEW already exists"
gh release view "v$NEW" >/dev/null 2>&1 && fail "a release named v$NEW already exists"

BUILD=$(( $(/usr/libexec/PlistBuddy -c "Print :CFBundleVersion" Info.plist) + 1 ))

say "Releasing $CURRENT -> $NEW (build $BUILD, $BUMP)"
if $DRY_RUN; then
    say "Dry run — stopping here"
    exit 0
fi

# ------------------------------------------------------------------- bump

say "Running the tests"
make test >/dev/null || fail "tests failed — not releasing"

/usr/libexec/PlistBuddy -c "Set :CFBundleShortVersionString $NEW" Info.plist
/usr/libexec/PlistBuddy -c "Set :CFBundleVersion $BUILD" Info.plist

# main is a protected branch, so the bump goes through a pull request. Pushing
# it straight to main is rejected by the branch hook.
WORK="release-$NEW"
git checkout -q -B "$WORK"
git add Info.plist
git commit -q -m "chore: bump to $NEW"
git push -q -u origin "$WORK"

say "Opening the pull request"
gh pr create --base main --head "$WORK" \
    --title "chore: bump to $NEW" \
    --body "Version bump for the v$NEW release. Cut by \`Scripts/release\`.

\`CFBundleShortVersionString\` $CURRENT → $NEW, \`CFBundleVersion\` $BUILD. The Makefile reads
\`VERSION\` from this plist, so the artifact filenames follow.

$(printf '%s\n' "${SUBJECTS[@]}" | sed 's/^/- /')" >/dev/null

say "Waiting for CI"
gh pr checks "$WORK" --watch --interval 15 || fail "CI failed on the bump PR — nothing was tagged"

say "Merging"
gh pr merge "$WORK" --merge --delete-branch

git checkout -q main
git fetch --quiet origin
git merge --ff-only origin/main --quiet
git branch -q -D "$WORK" 2>/dev/null || true

# ------------------------------------------------------------------- tag

say "Tagging v$NEW"
git tag "v$NEW"
git push -q origin "v$NEW"

say "Waiting for the release build"
sleep 5
RUN=$(gh run list --workflow=release.yml --limit 1 --json databaseId -q '.[0].databaseId')
gh run watch "$RUN" --exit-status || fail "the release workflow failed — tag v$NEW is pushed but there is no release"

# ---------------------------------------------------------------- appcast

# Signed here rather than in the workflow, and deliberately: the private key
# stays in this Mac's login Keychain and never becomes a GitHub secret, because
# a secret is readable by anything running in that job — and this repo is public
# and the workflow uses third-party actions. A leak of this key means pushing
# arbitrary code to every user of an app that reads their brokerage account.
#
# Signing the *published* zip rather than a local build is the same instinct as
# the verification below: what a user actually downloads is what matters.
say "Signing the appcast"
sparkle_tools
STAGE=$(mktemp -d)
gh release download "v$NEW" --pattern "Zielzeit-$NEW.zip" --dir "$STAGE" \
    || fail "could not download Zielzeit-$NEW.zip from the release"

# The zip, not the dmg: users click the dmg, Sparkle downloads the zip, which is
# the archive format it handles most reliably and which `ditto --keepParent`
# already produces. So no new build artifact — only appcast.xml.
#
# generate_appcast reads CFBundleVersion, CFBundleShortVersionString and
# LSMinimumSystemVersion out of the app itself, so the appcast cannot disagree
# with the bundle it describes.
"$SPARKLE_TOOLS/bin/generate_appcast" \
    --download-url-prefix "https://github.com/$REPO/releases/download/v$NEW/" \
    --full-release-notes-url "https://github.com/$REPO/releases" \
    "$STAGE" \
    || fail "generate_appcast failed — is the EdDSA private key in this Mac's Keychain?"

[ -f "$STAGE/appcast.xml" ] || fail "generate_appcast produced no appcast.xml"
gh release upload "v$NEW" "$STAGE/appcast.xml" || fail "could not upload appcast.xml"
rm -rf "$STAGE"

# --------------------------------------------------------------- verify

# The v1.1 release went out with an empty asset list, so "the workflow passed"
# is not the check that matters: what a user can actually download is.
say "Verifying the published release"
read -r IS_DRAFT ASSETS < <(gh release view "v$NEW" --json isDraft,assets -q '"\(.isDraft) \(.assets|length)"')
[ "$IS_DRAFT" = "false" ] || fail "v$NEW published as a draft — publish it by hand, do not create a second release on the tag"
[ "$ASSETS" -eq 4 ] || fail "v$NEW has $ASSETS assets, expected 4 (Zielzeit-$NEW.dmg, .zip, Zielzeit.dmg and appcast.xml)"

# Both URLs, because they fail independently. The versioned one is what this
# release published; the unversioned one is what every link already out there
# points at — the README, the directory listings, comments nobody can edit —
# and it only resolves if this release carried an asset named Zielzeit.dmg.
# Miss that and the old link does not keep serving v$NEW, it starts 404ing.
for URL in \
    "https://github.com/$REPO/releases/latest/download/Zielzeit-$NEW.dmg" \
    "https://github.com/$REPO/releases/latest/download/Zielzeit.dmg" \
    "https://github.com/$REPO/releases/latest/download/appcast.xml"; do
    # Assets can 404 for up to a minute after upload while the CDN catches up,
    # so give it a few tries before calling it broken.
    for _ in 1 2 3 4 5 6; do
        CODE=$(curl -sI -L -o /dev/null -w '%{http_code}' "$URL")
        [ "$CODE" = "200" ] && break
        sleep 10
    done
    [ "$CODE" = "200" ] || fail "$URL returned $CODE — the asset is not reachable"
done

# The check with no precedent here, and the one that matters most. An appcast
# that parses, resolves and advertises the *previous* version is indistinguishable
# from a working update channel until a user reports being stuck three releases
# back. The feed URL follows the latest release, so this is also what catches a
# release that published without an appcast and left the old one serving.
say "Checking the appcast advertises v$NEW"
FEED=$(mktemp)
curl -fsSL -o "$FEED" "https://github.com/$REPO/releases/latest/download/appcast.xml" \
    || fail "could not fetch the published appcast"
# Sparkle has emitted the version as an element and as an enclosure attribute in
# different releases, so both are accepted rather than pinning to one shape.
FEED_VERSION=$(xmllint --xpath 'string((//item[1]/*[local-name()="shortVersionString"] | //item[1]/enclosure/@*[local-name()="shortVersionString"])[1])' "$FEED" 2>/dev/null || echo "")
rm -f "$FEED"
[ "$FEED_VERSION" = "$NEW" ] \
    || fail "the appcast advertises '$FEED_VERSION', expected $NEW — users would not be offered this release"

say "Released v$NEW"
gh release view "v$NEW" --json url -q .url
