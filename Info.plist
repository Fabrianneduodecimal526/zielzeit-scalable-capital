<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Zielzeit</string>
	<!-- Declared even though the strings live in Swift rather than in .lproj
	     bundles. This is what puts Zielzeit in System Settings › General ›
	     Language & Region › Applications, and that picker works by writing
	     AppleLanguages into the app's own defaults domain — which is exactly what
	     Locale.preferredLanguages reads. So declaring the two languages is what
	     lets a user run a German Zielzeit on an English Mac. -->
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>de</string>
	</array>
	<key>CFBundleDisplayName</key>
	<string>Zielzeit</string>
	<key>CFBundleIdentifier</key>
	<string>com.zielzeit.Zielzeit</string>
	<key>CFBundleExecutable</key>
	<string>Zielzeit</string>
	<key>CFBundleIconFile</key>
	<string>Zielzeit</string>
	<key>CFBundleIconName</key>
	<string>Zielzeit</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>15.0</string>
	<!-- Menu bar only: no Dock icon, no app switcher entry. -->
	<key>LSUIElement</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>Zielzeit</string>
</dict>
</plist>
